set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEBA6U23I7
set_global_assignment -name TOP_LEVEL_ENTITY sha256_compress
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_FILE ../rtl/sha256/sha256_round.v
set_global_assignment -name VERILOG_FILE ../rtl/sha256/sha256_core.v
set_global_assignment -name VERILOG_FILE ../rtl/sha256/sha256_compress.v
set_global_assignment -name SDC_FILE lms_verifier.sdc
set_instance_assignment -name VIRTUAL_PIN ON -to block[*]
set_instance_assignment -name VIRTUAL_PIN ON -to state_in[*]
set_instance_assignment -name VIRTUAL_PIN ON -to state_out[*]
set_instance_assignment -name VIRTUAL_PIN ON -to start
set_instance_assignment -name VIRTUAL_PIN ON -to done
set_instance_assignment -name VIRTUAL_PIN ON -to busy

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"